# ─────────────────────────────────────────────────────────────
# PRIVACY 21719 — variables de entorno
# Copie este archivo a ".env" y complete los valores.
# NUNCA suba el archivo .env a git ni lo comparta.
# ─────────────────────────────────────────────────────────────

# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor (API + aplicación web en producción)
PORT=4000

# URL pública de la aplicación (se usa para validar el origen de las peticiones)
# En desarrollo con Vite: http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL
DATABASE_URL=postgres://privacy:privacy@localhost:5432/privacy21719

# Duración de la sesión en horas
SESSION_TTL_HOURS=12

# Clave para cifrar los tokens de integración guardados por clínica (AES-256-GCM).
# Debe ser de 32 bytes en base64. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# Carpeta donde se guardan los archivos de evidencia (fuera de la carpeta pública)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── Integración con software clínico ─────────────────────────
# Las credenciales de cada clínica se ingresan en la aplicación (Software clínico → Conexión)
# y se guardan cifradas. Las variables de abajo son una alternativa para una instalación
# de una sola clínica: se aplican SOLO a la clínica cuyo identificador sea INTEGRATION_ENV_ORG_SLUG.
INTEGRATION_ENV_ORG_SLUG=

# Proveedor: mock | dentalink | medilink
CLINIC_SOFTWARE_PROVIDER=mock

# Dentalink (HealthAtom). Verifique la URL base en la documentación oficial.
DENTALINK_API_BASE_URL=https://api.dentalink.healthatom.com/api/v1
DENTALINK_API_TOKEN=

# Medilink (HealthAtom). Verifique la URL base en la documentación oficial.
MEDILINK_API_BASE_URL=https://api.medilink.healthatom.com/api/v1
MEDILINK_API_TOKEN=

# Máximo de páginas a leer por recurso en cada sincronización (protección ante bucles)
INTEGRATION_MAX_PAGES=50
# Tiempo máximo por petición a la API externa (ms)
INTEGRATION_TIMEOUT_MS=15000
